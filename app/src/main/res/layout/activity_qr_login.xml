<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101010"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/qrTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/qr_title"
        android:textColor="@color/accent"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/qrCodeView"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginBottom="24dp"
        android:background="#FFFFFFFF"
        android:contentDescription="@string/qr_title"
        android:padding="10dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/qrInstructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/qr_instructions"
        android:textColor="#CCFFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/qrStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#FFCCCCCC"
        android:textSize="14sp" />
</LinearLayout>
