<?xml version="1.0" encoding="utf-8"?>
<!-- One "Continue Watching" card: 16:9 art with a title, thin red progress
     bar and a time-left line over the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dip"
    android:layout_height="150dip"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:longClickable="true">

    <ImageView
        android:id="@+id/continueArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#101010" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#D9141414"
        android:paddingLeft="8dip"
        android:paddingRight="8dip"
        android:paddingTop="5dip"
        android:paddingBottom="6dip">

        <TextView
            android:id="@+id/continueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/continueProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dip"
            android:layout_marginTop="4dip"
            android:max="1000"
            android:progressDrawable="@drawable/continue_progress" />

        <TextView
            android:id="@+id/continueMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dip"
            android:singleLine="true"
            android:textColor="#CCCCCC"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
