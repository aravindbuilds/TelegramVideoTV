<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nd_background">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Two scrims: left edge behind the poster/text, bottom fade like the reference -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/details_scrim_bottom" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/details_scrim_left" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="36dp"
            android:paddingBottom="20dp">

            <ImageView
                android:id="@+id/poster"
                android:layout_width="150dp"
                android:layout_height="225dp"
                android:layout_marginEnd="28dp"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_poster"
                android:clipToOutline="true"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Big title + small grey inline year: "TitleName (2026)" -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="#FFFFFFFF"
                        android:textSize="36sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Cert/quality chip + "07/29/2026 · Sci-Fi, Action · 2h 25m" meta -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cert_chip"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/txtMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="#FFB3B3B3"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Action row: user-rating block, Resume, Play Again, circles -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Composite user-rating block (reference layout) -->
                    <LinearLayout
                        android:id="@+id/txtRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rating_block"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_star_badge"
                            android:gravity="center"
                            android:text="\u2605"
                            android:textColor="#FFEA9C28"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/txtRatingValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="21sp"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:layout_marginTop="4dp"
                                    android:text="/\u00A010"
                                    android:textColor="#FF9E9E9E"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="USER RATING"
                                android:textColor="#FFCCCCCC"
                                android:textSize="9sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnPlay"
                        android:defaultFocusHighlightEnabled="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="130dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_pill_red"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="\u25B6\u00A0Play"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <Button
                        android:id="@+id/btnReplay"
                        android:defaultFocusHighlightEnabled="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="120dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="\u21BB\u00A0Play Again"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone" />

                    <!-- Toggle bookmark icon (filled/check), set by renderWatchlistState -->
                    <ImageButton
                        android:id="@+id/btnWatchlist"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/bg_circle"
                        android:contentDescription="@string/add_to_watchlist"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_bookmark" />

                    <ImageButton
                        android:id="@+id/btnDownload"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_circle"
                        android:contentDescription="@string/download_description"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_download" />

                    <!-- Remove: clean ✕ on the styled red disc -->
                    <ImageButton
                        android:id="@+id/btnRemove"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_circle_red"
                        android:contentDescription="@string/remove_description"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_x" />
                </LinearLayout>

                <!-- Italic quoted tagline -->
                <TextView
                    android:id="@+id/txtTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFB8B8B8"
                    android:textSize="15sp"
                    android:textStyle="italic"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtOverviewLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="OverView"
                    android:textAllCaps="true"
                    android:textColor="#FF8A8A8A"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxWidth="780dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#FFE8E8E8"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.25" />

                <TextView
                    android:id="@+id/txtCredits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxWidth="880dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FF9E9E9E"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FF8A8A8A"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtVersionsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="#FFB3B3B3"
                    android:textSize="13sp"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:id="@+id/versionsList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
